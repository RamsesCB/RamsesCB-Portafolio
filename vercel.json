{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/arcade",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/portafolio",
      "dest": "/portafolio.html"
    },
    {
      "src": "/prompts",
      "dest": "/prompts.html"
    },
    {
      "src": "/connections.xml",
      "dest": "/connections.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
